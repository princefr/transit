# Copy to .env and fill values. Never commit .env.
#
# PRIM SIRI Lite — live IDFM trip updates, vehicles, alerts (apikey header).
# Get a key: https://prim.iledefrance-mobilites.fr/
IDFM_PRIM_API_KEY=your_prim_api_key_here

# data.gouv.fr / transport.data.gouv.fr GTFS downloads (X-API-KEY header).
# Used by make sync-idfm, scripts/daily_sync.sh, and optional [[feeds]] auth_env.
# Set one of the two aliases below (DATASETS_API_KEY is checked first).
# Get a key from your data.gouv.fr account if the portal requires authentication.
DATASETS_API_KEY=your_datasets_api_key_here
DATAGOUV_API_KEY=your_datasets_api_key_here
