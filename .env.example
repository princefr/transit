# Copy to .env and fill values. Never commit .env.
#
# PRIM marketplace API keys (same family): https://prim.iledefrance-mobilites.fr/
# One PRIM key can be reused in both vars below — realtime uses apikey, downloads use X-API-KEY.
#
# Realtime: PRIM SIRI Lite — live IDFM trip updates, vehicles, alerts (apikey header).
IDFM_PRIM_API_KEY=your_prim_api_key_here

# Static GTFS downloads (X-API-KEY header): make sync-idfm, scripts/daily_sync.sh,
# optional [[feeds]] auth_env. Same PRIM marketplace key — not a separate data.gouv.fr key.
# Aliases: DATASETS_API_KEY (checked first) or DATAGOUV_API_KEY — set one, not both.
# Optional for public data.gouv.fr resource URLs; required for PRIM Datahub / gated portals.
DATASETS_API_KEY=your_prim_api_key_here
DATAGOUV_API_KEY=your_prim_api_key_here
