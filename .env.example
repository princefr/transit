# Copy to .env and fill values. Never commit .env.
#
# PRIM marketplace: https://prim.iledefrance-mobilites.fr/
# Two separate keys — do not reuse the same value between realtime and dataset downloads.
#
# Realtime: PRIM SIRI Lite — live IDFM trip updates, vehicles, alerts (apikey header).
IDFM_PRIM_API_KEY=your_prim_realtime_api_key_here

# Dataset downloads (X-API-KEY header): make sync-idfm, scripts/daily_sync.sh,
# optional [[feeds]] auth_env. Separate PRIM Datahub / dataset key — not IDFM_PRIM_API_KEY.
# Optional for public data.gouv.fr resource URLs; required for PRIM Datahub / gated portals.
# Legacy fallbacks (checked after PRIM_DATASET_KEY): DATASETS_API_KEY, then DATAGOUV_API_KEY.
PRIM_DATASET_KEY=your_prim_dataset_api_key_here
# DATASETS_API_KEY=
# DATAGOUV_API_KEY=
